{
  "name": "scoped-event-log",
  "version": "3.3.0",
  "description": "Global event log with scoped entries.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Log": {
      "types": "./dist/Log.d.ts",
      "default": "./dist/Log.js"
    },
    "./LogInspector": {
      "types": "./dist/LogInspector.d.ts",
      "default": "./dist/LogInspector.js"
    },
    "./dist/Log": {
      "types": "./dist/Log.d.ts",
      "default": "./dist/Log.js"
    },
    "./dist/LogInspector": {
      "types": "./dist/LogInspector.d.ts",
      "default": "./dist/LogInspector.js"
    }
  },
  "files": [
    "dist/*",
    "umd/*",
    "package.json",
    "custom-elements.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:manifest",
    "_comment_build_vite": "build:inspector and build:log require Vite 7, which needs Node >= 20.19. They are not part of the default `build` script — tsc emits ESM directly into `dist/`, which is what consumers (webpack, Vite, Rollup) resolve via `main` / `module`. The Vite scripts only matter for standalone UMD bundles in umd/inspector/ or umd/log/.",
    "build:inspector": "vite build --config vite.config.inspector.ts",
    "build:log": "vite build --config vite.config.log.ts",
    "build:manifest": "custom-elements-manifest analyze",
    "dev": "vite",
    "lint": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public && git push --follow-tags",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [
    "logging",
    "typescript"
  ],
  "author": "Sampsa Lohi",
  "license": "MIT",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.11.0",
    "typescript": "~5.7.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.1.0",
    "lit": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-19/scoped-event-log.git"
  },
  "bugs": {
    "url": "https://github.com/sam-19/scoped-event-log/issues"
  },
  "homepage": "https://github.com/sam-19/scoped-event-log#readme",
  "customElements": "custom-elements.json"
}
